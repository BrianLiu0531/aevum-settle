# Copy to .env and fill in. Never commit .env: it holds private keys.
# Use fresh keys made for the testnet only.

# ---- wallets ----
# Deploys the router; also the owner whose tUSD8 the agent spends.
# Fund it with tQDAY + tUSD8 from https://faucet.qday.info
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
OWNER_PRIVATE_KEY=
# The agent's own key: it signs payments under the mandate and pays gas (send it a little tQDAY
# with `node demo/agent.js owner fund-agent`). It never holds the owner's tUSD8.
AGENT_PRIVATE_KEY=
# Where the demo merchant gets paid
MERCHANT_ADDRESS=
# Optional: lets the merchant settle x402 "exact" payments and send refunds (it pays that gas)
MERCHANT_PRIVATE_KEY=
CHAIN_ID=44005
# RPC_URL=https://rpc-test.qday.info

# ---- settler ----
NETWORK=qday-testnet
# Written by `npm run deploy` in contracts/
ROUTER_ADDRESS=
# Block the router was deployed in (indexing starts here)
START_BLOCK=
# Optional: only index payments to these merchants (comma-separated); empty = all
# MERCHANTS=
# Assurance needed before payment.confirmed, by amount in tUSD8 (trusted ~1s, virtual ~10min, verified ~90min)
# CONFIRM_POLICY=trusted<=1,virtual<=100,verified
# Deliver events as HMAC-signed JSON; unset = events are written to the log.
# The merchant verifies with the same secret.
WEBHOOK_URL=http://merchant:8787/webhooks/settle
WEBHOOK_SECRET=

# Optional (defaults shown)
# RPC_URLS=https://rpc-test.qday.info
# DATABASE_URL=postgres://postgres:postgres@localhost:5441/settler?sslmode=disable
# MAX_BLOCK_RANGE=1000          # QDay rejects eth_getLogs ranges over 1000 blocks
# MAX_UNFINALIZED_BATCH=100
# POLL_INTERVAL=1s
# RPC_MAX_RPS=20
# HTTP_ADDR=:8080
# LOG_LEVEL=info
# LOG_FORMAT=json
# Local dev chains only: simulate virtual/verified as N blocks deep
# LOCAL_VIRTUAL_DEPTH=0
# LOCAL_VERIFIED_DEPTH=0

# ---- demo merchant + agent ----
# SETTLER_URL=http://localhost:8080
# MERCHANT_URL=http://localhost:8787
# MERCHANT_PORT=8787
# INVOICE_TTL_SECONDS=900
# Prices in tUSD8 (defaults span the three policy tiers, and one is above the demo mandate's cap)
# PRICE_QUOTE=0.05
# PRICE_REPORT=20
# PRICE_ARCHIVE=120
# PRICE_BULK=500
# The agent's own ceiling per purchase, below the mandate
# AGENT_MAX_PRICE=
# Merchant: public URL in x402 resource info, invoice database, refunds
# MERCHANT_PUBLIC_URL=http://localhost:8787
# MERCHANT_DB=demo/data/merchant.db
# AUTO_REFUND=true
# MERCHANT_ADMIN_TOKEN=            # bearer token for POST /api/invoices/{id}/refund

# ---- AI agent (demo/ai-agent.js) ----
# Claude API credentials: ANTHROPIC_API_KEY, or run `ant auth login` once
# ANTHROPIC_API_KEY=
# Ask a human before any purchase above this many tUSD8
# AGENT_CONFIRM_ABOVE=
# How long buy() waits for the merchant before reporting "pending"
# AGENT_WAIT_SECONDS=120
